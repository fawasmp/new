<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_stock_warning_wizard" model="ir.ui.view">
        <field name="name">sale.order.stock.warning.wizard.form</field>
        <field name="model">stock.pick.invoice</field>
        <field name="arch" type="xml">
            <form string="Insufficient Stock">
                <group>
                    <p>This is not linked to any of the sale order...</p>
                </group>
                <footer>
                    <button name="action_create_invoice" string="Create invoice" type="object" class="btn-primary"/>
                    <button name="action_normal_validate" string="Normal validate" type="object" class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
